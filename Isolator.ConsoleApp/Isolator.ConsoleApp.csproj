<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <FodyName>Isolator</FodyName>
  </PropertyGroup>

  <!--<PropertyGroup Condition="$(Configuration.Contains('Debug'))">
    <Revision>$([MSBuild]::Divide($([System.DateTime]::Now.TimeOfDay.TotalSeconds), 4).ToString('F0'))</Revision>
    <PackageAssemblyVersion>.Dev.$(Version).$(Revision)</PackageAssemblyVersion>
    <AssemblyName>$(AssemblyName)$(PackageAssemblyVersion)</AssemblyName>
  </PropertyGroup>-->
  
  <ItemGroup>
    <ProjectReference Include="..\$(FodyName).Fody\$(FodyName).Fody.csproj" ReferenceOutputAssembly="false" PrivateAssets="All" />
    <WeaverFiles Include="..\$(FodyName).Fody\bin\$(Configuration)\netstandard2.0\$(FodyName).Fody.dll" />
  </ItemGroup>

  <PropertyGroup>
    <WeaverConfiguration>
      <Weavers>
        <Isolator />
      </Weavers>
    </WeaverConfiguration>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\$(FodyName)\$(FodyName).csproj" PrivateAssets="All" />
  </ItemGroup>

</Project>
