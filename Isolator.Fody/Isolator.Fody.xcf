<?xml version="1.0" encoding="utf-8" ?>
<xs:complexType xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:all>
    <xs:element minOccurs="0" maxOccurs="1" name="ClassNames" type="xs:string">
      <xs:annotation>
        <xs:documentation>Class names to isolate.</xs:documentation>
      </xs:annotation>
    </xs:element>
    <xs:element minOccurs="0" maxOccurs="1" name="InterfaceNames" type="xs:string">
      <xs:annotation>
        <xs:documentation>Interface names to isolate.</xs:documentation>
      </xs:annotation>
    </xs:element>
  </xs:all>
  <xs:attribute name="ClassNames" type="xs:string">
    <xs:annotation>
      <xs:documentation>Class names to isolate, delimited with |.</xs:documentation>
    </xs:annotation>
  </xs:attribute>
  <xs:attribute name="InterfaceNames" type="xs:string">
    <xs:annotation>
      <xs:documentation>Interface names to isolate, delimited with |.</xs:documentation>
    </xs:annotation>
  </xs:attribute>
  <xs:attribute name="ContextName" type="xs:string">
    <xs:annotation>
      <xs:documentation>Name of the isolation context.</xs:documentation>
    </xs:annotation>
  </xs:attribute>
  <xs:attribute name="Collectible" type="xs:boolean">
    <xs:annotation>
      <xs:documentation>Enable collectible in the 'IsolatorAssemblyLoadContext' template.</xs:documentation>
    </xs:annotation>
  </xs:attribute>
  <xs:attribute name="EnableDebug" type="xs:boolean">
    <xs:annotation>
      <xs:documentation>Force the template with the debug log enable.</xs:documentation>
    </xs:annotation>
  </xs:attribute>
  <xs:attribute name="SkipIsolator" type="xs:boolean">
    <xs:annotation>
      <xs:documentation>Skip the isolation process.</xs:documentation>
    </xs:annotation>
  </xs:attribute>
  <xs:attribute name="LoadAtModuleInit" type="xs:boolean">
    <xs:annotation>
      <xs:documentation>Enable loading default context at module initialization.</xs:documentation>
    </xs:annotation>
  </xs:attribute>
  <xs:attribute name="EnableCloneMethods" type="xs:boolean">
    <xs:annotation>
      <xs:documentation>Enable cloning methods.</xs:documentation>
    </xs:annotation>
  </xs:attribute>
  <xs:attribute name="EnableWriteBackRefOutParameters" type="xs:boolean">
    <xs:annotation>
      <xs:documentation>This flag disables the use of `ref` and `out` parameters in the weaving process.</xs:documentation>
    </xs:annotation>
  </xs:attribute>
</xs:complexType>