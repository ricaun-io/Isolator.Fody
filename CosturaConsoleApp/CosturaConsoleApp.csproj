<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Costura.Fody\Costura.Fody.csproj" ReferenceOutputAssembly="false" PrivateAssets="All" />
    <WeaverFiles Include="..\Costura.Fody\bin\$(Configuration)\netstandard2.0\Costura.Fody.dll" />
  </ItemGroup>

  <PropertyGroup>
    <WeaverConfiguration>
      <Weavers>
        <Costura />
      </Weavers>
    </WeaverConfiguration>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Costura\Costura.csproj" PrivateAssets="All" />
  </ItemGroup>

</Project>
